<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDynamicLoading>true</EnableDynamicLoading>

        <!-- Shown in Settings > Addons (read without loading the assembly) -->
        <AssemblyTitle>Noctalia Notifications</AssemblyTitle>
        <Description>Shows desktop notifications through the Noctalia shell (Linux).</Description>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ED.Assistant.Plugins.Abstractions\ED.Assistant.Plugins.Abstractions.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <!-- Same versions as the host. ExcludeAssets="runtime": at runtime these come from the host
         (see SharedPrefixes in PluginLoadContext). Avalonia / Material.Icons are only needed
         to compile against IPlugin (PluginPage uses Control and MaterialIconKind). -->
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" ExcludeAssets="runtime"/>
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" ExcludeAssets="runtime"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.1.26425.128" ExcludeAssets="runtime"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="addon.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- Debug builds copy themselves into the app's plugins folder:
         <AppData>/ed-assistant/plugins/ED.Assistant.Plugins.NoctaliaDesktopNotifier/
         Override with: dotnet build -p:EdPluginsRoot=/some/path -->
    <PropertyGroup>
        <EdPluginsRoot Condition="'$(EdPluginsRoot)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.ApplicationData))/ed-assistant/plugins</EdPluginsRoot>
    </PropertyGroup>

    <Target Name="DeployPluginLocally" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
        <ItemGroup>
            <_PluginOutput Include="$(OutDir)**/*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(_PluginOutput)"
              DestinationFiles="@(_PluginOutput->'$(EdPluginsRoot)/$(AssemblyName)/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Message Importance="high" Text="Noctalia notifier plugin deployed to $(EdPluginsRoot)/$(AssemblyName)"/>
    </Target>
</Project>
