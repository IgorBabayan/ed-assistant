<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <VersionPrefix>1.0</VersionPrefix>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <!-- lets ubuntu-latest build the Windows target -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>

    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Presentation\Styles\Border.axaml"/>
        <AvaloniaXaml Remove="Presentation\Styles\ComboBox.axaml"/>
        <AvaloniaXaml Remove="Presentation\Styles\TextBlock.axaml"/>
        <AvaloniaXaml Remove="Presentation\Styles\Theme.axaml"/>
        <AvaloniaXaml Remove="Presentation\Styles\TreeView.axaml"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Presentation\Styles\Border.axaml"/>
        <AvaloniaResource Include="Presentation\Styles\ComboBox.axaml"/>
        <AvaloniaResource Include="Presentation\Styles\TextBlock.axaml"/>
        <AvaloniaResource Include="Presentation\Styles\Theme.axaml"/>
        <AvaloniaResource Include="Presentation\Styles\TreeView.axaml"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7"/>
        <!-- Override EF Core's transitive SQLite bundle to resolve NU1903. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13"/>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0-rc.1.26425.128"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ED.Assistant.Plugins.Abstractions\ED.Assistant.Plugins.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UpdateRepository)' != ''">
        <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Assets\Biology\Bacterium\"/>
        <Folder Include="Assets\Biology\BrainTree\"/>
        <Folder Include="Assets\Biology\Cactoida\"/>
        <Folder Include="Assets\Biology\Clypeus\"/>
        <Folder Include="Assets\Biology\Concha\"/>
        <Folder Include="Assets\Biology\Electricae\"/>
        <Folder Include="Assets\Biology\Fonticulua\"/>
        <Folder Include="Assets\Biology\Frutexa\"/>
        <Folder Include="Assets\Biology\Fumerola\"/>
        <Folder Include="Assets\Biology\Fungoida\"/>
        <Folder Include="Assets\Biology\Osseus\"/>
        <Folder Include="Assets\Biology\Recepta\"/>
        <Folder Include="Assets\Biology\Crystalline Shard\"/>
        <Folder Include="Assets\Biology\Stratum\"/>
        <Folder Include="Assets\Biology\Tuber\"/>
        <Folder Include="Assets\Biology\Tubus\"/>
        <Folder Include="Assets\Biology\Tussock\"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ED.Assistant.Plugins.Abstractions\ED.Assistant.Plugins.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Presentation\Views\Plugin\PluginSettingsDialogWindow.axaml.cs">
        <DependentUpon>PluginSettingsDialogWindow.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
