<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:materialIcons="using:Material.Icons.Avalonia">

	<!-- ===== Dock container =====
	     Panel.dock is a transparent host. The pill background is a separate
	     sibling Border, so it can never clip the magnified icons. The host's
	     margin on the side facing the content reserves room for magnification. -->
	<Style Selector="Panel.dock">
		<Setter Property="ZIndex" Value="10"/>
		<Setter Property="ClipToBounds" Value="False"/>
	</Style>

	<Style Selector="Panel.dock Border.dock-background">
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="18"/>
		<Setter Property="BoxShadow" Value="0 8 24 0 #66000000"/>
		<Setter Property="IsHitTestVisible" Value="False"/>
	</Style>

	<Style Selector="Panel.dock ItemsControl.dock-items">
		<Setter Property="Margin" Value="9"/>
		<Setter Property="ClipToBounds" Value="False"/>
	</Style>

	<Style Selector="Panel.dock.bottom">
		<Setter Property="DockPanel.Dock" Value="Bottom"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="0,24,0,12"/>
	</Style>

	<Style Selector="Panel.dock.left">
		<Setter Property="DockPanel.Dock" Value="Left"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="12,0,24,0"/>
	</Style>

	<Style Selector="Panel.dock.right">
		<Setter Property="DockPanel.Dock" Value="Right"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="24,0,12,0"/>
	</Style>

	<!-- ===== Dock button (app icon) ===== -->
	<Style Selector="Button.dock-button">
		<Setter Property="Width" Value="48"/>
		<Setter Property="Height" Value="48"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="RenderTransform" Value="scale(1)"/>
		<Setter Property="Transitions">
			<Transitions>
				<TransformOperationsTransition Property="RenderTransform"
											   Duration="0:0:0.15"
											   Easing="CubicEaseOut"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Button.dock-button materialIcons|MaterialIcon">
		<Setter Property="Width" Value="26"/>
		<Setter Property="Height" Value="26"/>
	</Style>

	<!-- Magnification: grows away from the screen edge -->
	<Style Selector="Button.dock-button:pointerover">
		<Setter Property="RenderTransform" Value="scale(1.3)"/>
	</Style>
	<Style Selector="Button.dock-button:pressed">
		<Setter Property="RenderTransform" Value="scale(1.15)"/>
	</Style>

	<Style Selector="Button.dock-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource SecondaryAccentBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
	</Style>

	<Style Selector="Button.dock-button.active /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
	</Style>

	<Style Selector="Panel.dock.bottom Button.dock-button">
		<Setter Property="RenderTransformOrigin" Value="50%,100%"/>
		<Setter Property="ToolTip.Placement" Value="Top"/>
		<Setter Property="ToolTip.HorizontalOffset" Value="0"/>
		<Setter Property="ToolTip.VerticalOffset" Value="-22"/>
	</Style>
	<Style Selector="Panel.dock.left Button.dock-button">
		<Setter Property="RenderTransformOrigin" Value="0%,50%"/>
		<Setter Property="ToolTip.Placement" Value="Right"/>
		<Setter Property="ToolTip.HorizontalOffset" Value="22"/>
		<Setter Property="ToolTip.VerticalOffset" Value="0"/>
	</Style>
	<Style Selector="Panel.dock.right Button.dock-button">
		<Setter Property="RenderTransformOrigin" Value="100%,50%"/>
		<Setter Property="ToolTip.Placement" Value="Left"/>
		<Setter Property="ToolTip.HorizontalOffset" Value="-22"/>
		<Setter Property="ToolTip.VerticalOffset" Value="0"/>
	</Style>

	<!-- ===== Active indicator dot (sits between the icon and the screen edge) ===== -->
	<Style Selector="Ellipse.dock-indicator">
		<Setter Property="Width" Value="5"/>
		<Setter Property="Height" Value="5"/>
		<Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="IsHitTestVisible" Value="False"/>
	</Style>

	<Style Selector="Panel.dock.bottom Ellipse.dock-indicator">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Bottom"/>
		<Setter Property="Margin" Value="0,0,0,-7"/>
	</Style>
	<Style Selector="Panel.dock.left Ellipse.dock-indicator">
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="-7,0,0,0"/>
	</Style>
	<Style Selector="Panel.dock.right Ellipse.dock-indicator">
		<Setter Property="HorizontalAlignment" Value="Right"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="0,0,-7,0"/>
	</Style>

	<!-- ===== Separator ===== -->
	<Style Selector="Border.dock-separator">
		<Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
	</Style>
	<Style Selector="Panel.dock.bottom Border.dock-separator">
		<Setter Property="Width" Value="1"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="Margin" Value="4,0"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Panel.dock.left Border.dock-separator, Panel.dock.right Border.dock-separator">
		<Setter Property="Height" Value="1"/>
		<Setter Property="Width" Value="32"/>
		<Setter Property="Margin" Value="0,4"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>
</Styles>
