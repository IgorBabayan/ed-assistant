<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<!-- Add Controls for Previewer Here -->
		</Border>
	</Design.PreviewWith>

	<!-- Add Styles Here -->
	<Style Selector="Border.sidebar">
		<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
		<Setter Property="BorderThickness" Value="0,0,1,0"/>
	</Style>

	<Style Selector="Border.dashboard-card">
		<Setter Property="Background" Value="#111927"/>
		<Setter Property="BorderBrush" Value="#233044"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="16"/>
	</Style>

	<Style Selector="Border.signal-row">
		<Setter Property="Background" Value="#0B0F14"/>
		<Setter Property="BorderBrush" Value="#233044"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="6"/>
		<Setter Property="Padding" Value="10"/>
		<Setter Property="Margin" Value="0,0,0,8"/>
	</Style>

	<Style Selector="Border.signal-badge">
		<Setter Property="Background" Value="#1D2A3D"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="Padding" Value="8,4"/>
	</Style>

	<Style Selector="Border.signal-badge > TextBlock">
		<Setter Property="Foreground" Value="#C9D4E3"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<!-- Body signals: same hues as Border.signal-dot in the System view -->
	<Style Selector="Border.signal-badge[Tag=Biological]">
		<Setter Property="Background" Value="#2645D483"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Biological] > TextBlock">
		<Setter Property="Foreground" Value="#45D483"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Geological]">
		<Setter Property="Background" Value="#26D89A4A"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Geological] > TextBlock">
		<Setter Property="Foreground" Value="#D89A4A"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Human]">
		<Setter Property="Background" Value="#264FA3FF"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Human] > TextBlock">
		<Setter Property="Foreground" Value="#4FA3FF"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Thargoid]">
		<Setter Property="Background" Value="#26B86CFF"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Thargoid] > TextBlock">
		<Setter Property="Foreground" Value="#B86CFF"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Guardian]">
		<Setter Property="Background" Value="#264FD1C5"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Guardian] > TextBlock">
		<Setter Property="Foreground" Value="#4FD1C5"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Hotspot]">
		<Setter Property="Background" Value="#26FF6FB5"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Hotspot] > TextBlock">
		<Setter Property="Foreground" Value="#FF6FB5"/>
	</Style>

	<!-- System signals -->
	<Style Selector="Border.signal-badge[Tag=USS]">
		<Setter Property="Background" Value="#26FFB86B"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=USS] > TextBlock">
		<Setter Property="Foreground" Value="#FFB86B"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Combat]">
		<Setter Property="Background" Value="#26FF5C5C"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Combat] > TextBlock">
		<Setter Property="Foreground" Value="#FF5C5C"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Resource]">
		<Setter Property="Background" Value="#26E8C547"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Resource] > TextBlock">
		<Setter Property="Foreground" Value="#E8C547"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Station] > TextBlock">
		<Setter Property="Foreground" Value="#7EA7FF"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Carrier] > TextBlock">
		<Setter Property="Foreground" Value="#7EA7FF"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Megaship] > TextBlock">
		<Setter Property="Foreground" Value="#7EA7FF"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Installation] > TextBlock">
		<Setter Property="Foreground" Value="#7EA7FF"/>
	</Style>

	<Style Selector="Border.signal-badge[Tag=Titan]">
		<Setter Property="Background" Value="#26B86CFF"/>
	</Style>
	<Style Selector="Border.signal-badge[Tag=Titan] > TextBlock">
		<Setter Property="Foreground" Value="#B86CFF"/>
	</Style>

	<Style Selector="Border.separator">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Background" Value="Gray"/>
	</Style>

	<Style Selector="Border.material-card">
		<Setter Property="Width" Value="260"/>
		<Setter Property="Margin" Value="6"/>
		<Setter Property="Padding" Value="14"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>

	<Style Selector="Border.material-card:pointerover">
		<Setter Property="BorderBrush" Value="{StaticResource SecondaryAccentBrush}"/>
	</Style>

	<Style Selector="Border.material-category-pill">
		<Setter Property="Padding" Value="8,3"/>
		<Setter Property="CornerRadius" Value="999"/>
		<Setter Property="Background" Value="{StaticResource SecondaryAccentBrush}"/>
	</Style>
</Styles>
