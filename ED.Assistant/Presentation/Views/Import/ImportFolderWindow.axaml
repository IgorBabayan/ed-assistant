<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:ED.Assistant.Presentation.ViewModels.Import"
		xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="ED.Assistant.Presentation.Views.Import.ImportFolderWindow"
		x:DataType="vm:ImportFolderViewModel"
		WindowDecorations="None"
		WindowStartupLocation="Manual"
		TransparencyLevelHint="Transparent"
		Background="Transparent"
		SizeToContent="Manual"
		CanResize="False"
		ShowInTaskbar="False">

	<Window.KeyBindings>
		<KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
	</Window.KeyBindings>

	<Grid Background="Transparent">
		<!-- Overlay background -->
		<Border Background="{DynamicResource TransparentBackgroundBrush}" />

		<!-- Dialog content -->
		<Border Background="{DynamicResource CardBackgroundBrush}"
				CornerRadius="12"
				Padding="20"
				Width="600"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">

			<StackPanel Spacing="{DynamicResource Spacing5}">
				<TextBlock Classes="primary"
						   Text="Import bio-samples"
						   FontSize="20"
						   FontWeight="Bold" />

				<TextBlock Text="Path to the folder with Journal.*.log files. Only samples that haven't been sold yet will appear in the Evaluator."
						   Opacity="0.6"
						   TextWrapping="Wrap"/>

				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Spacing5}">
					<TextBox x:Name="PathBox"
					         Grid.Column="0"
					         Text="{Binding FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					         PlaceholderText="~/path/to/Elite Dangerous journals"
					         TextWrapping="NoWrap">
						<TextBox.KeyBindings>
							<KeyBinding Gesture="Enter" Command="{Binding ImportCommand}"/>
						</TextBox.KeyBindings>
					</TextBox>

					<Button Grid.Column="1"
					        CommandParameter="{Binding $parent[Window]}"
					        Command="{Binding OpenFolderCommand}"
					        Classes="app-button">
						<avalonia:MaterialIcon Kind="FolderOpen"/>
					</Button>
				</Grid>

				<TextBlock Text="{Binding ErrorMessage}"
						   IsVisible="{Binding HasError}"
						   Foreground="#EF5350"
						   TextWrapping="Wrap"/>

				<StackPanel Spacing="{DynamicResource Spacing5}"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Margin="0,10,0,0">
					<Button Content="Import"
							Command="{Binding ImportCommand}"
							Classes="app-button"/>

					<Button Content="Cancel"
							Classes="app-button-default"
							Command="{Binding CancelCommand}"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>
