<Window xmlns="https://github.com/avaloniaui"
		xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ED.Assistant.Presentation.ViewModels.Shell"
		xmlns:conv="using:ED.Assistant.Presentation.Converters"
		xmlns:notifVm="clr-namespace:ED.Assistant.Presentation.ViewModels.Notifications"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="ED.Assistant.Presentation.Views.Shell.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/logo.ico"
		Background="Transparent"
		Title="ED Assistant"
		WindowDecorations="None"
		WindowStartupLocation="CenterScreen">
	<Border Background="{StaticResource BackgroundBrush}">
		<Grid RowDefinitions="36,*,36">

			<!-- Title bar -->
			<Border Grid.Row="0"
					Background="Transparent"
					PointerPressed="OnPointerPressed">
				<Grid ColumnDefinitions="Auto,*,Auto">

					<TextBlock Grid.Column="0"
							   Classes="primary"
							   Text="ED Assistant"
							   Margin="{StaticResource MarginLeft15}"
							   FontWeight="Bold"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />

					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								VerticalAlignment="Center"
								HorizontalAlignment="Center"
								Spacing="{DynamicResource Spacing5}">
						<TextBlock Text="{Binding Cmdr}" />
						<TextBlock Text="/" />
						<TextBlock Text="{Binding Ship}" />
						<TextBlock Text="/" />
						<TextBlock Text="{Binding Status}" />
					</StackPanel>

					<StackPanel Grid.Column="2"
								Orientation="Horizontal"
								VerticalAlignment="Top">
						<Button Classes="window-button"
						        ToolTip.Tip="Create desktop file"
						        IsVisible="{Binding IsLinux}"
						        Command="{Binding CreateDesktopCommand}">
							<materialIcons:MaterialIcon Kind="Computer"/>
						</Button>
						
						<Button Classes="window-button"
						        ToolTip.Tip="Load data"
						        Command="{Binding LoadCommand}">
							<materialIcons:MaterialIcon Kind="Reload"/>
						</Button>
						
						<Button Classes="window-button"
						        ToolTip.Tip="Import bio-samples"
						        Command="{Binding ImportCommand}">
							<Panel>
								<materialIcons:MaterialIcon Kind="DatabaseImport"
								                            IsVisible="{Binding !ImportCommand.IsRunning}"/>
								<materialIcons:MaterialIcon Kind="ProgressClock"
								                            IsVisible="{Binding ImportCommand.IsRunning}"/>
							</Panel>
						</Button>

						<Button Classes="window-button"
						        ToolTip.Tip="Settings"
								Command="{Binding SettingsCommand}"
								Margin="{StaticResource MarginRight15}">
							<materialIcons:MaterialIcon Kind="Settings"/>
						</Button>

						<Button Classes="window-button"
						        ToolTip.Tip="Minimize window"
								Click="OnMinimizeClick"
								IsVisible="{Binding IsNotHyprland}">
							<materialIcons:MaterialIcon Kind="WindowMinimize"/>
						</Button>

						<Button Classes="window-button"
						        ToolTip.Tip="Maximize window"
								Click="OnMaximizeClick"
								IsVisible="{Binding IsNotHyprland}">
							<materialIcons:MaterialIcon Kind="WindowMaximize"/>
						</Button>

						<Button Classes="window-button close"
						        ToolTip.Tip="Close window"
								Click="OnCloseClick">
							<materialIcons:MaterialIcon Kind="WindowClose"/>
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<!-- Content -->
			<DockPanel Grid.Row="1" LastChildFill="True">

				<!-- Dock -->
				<Panel Classes="dock"
				       Classes.bottom="{Binding IsDockBottom}"
				       Classes.left="{Binding IsDockLeft}"
				       Classes.right="{Binding IsDockRight}">

					<Border Classes="dock-background"/>

					<ItemsControl Classes="dock-items" ItemsSource="{Binding DockItems}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel x:DataType="vm:MainWindowViewModel"
								            Spacing="6"
								            Orientation="{Binding DockPosition, Converter={x:Static conv:DockPositionConverters.ToOrientation}}"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.DataTemplates>
							<DataTemplate DataType="vm:DockItemViewModel">
								<Panel>
									<Button Classes="dock-button"
									        Classes.active="{Binding IsActive}"
									        Command="{Binding Command}"
									        ToolTip.Tip="{Binding Title}">
										<materialIcons:MaterialIcon Kind="{Binding Icon}"/>
									</Button>
									<Ellipse Classes="dock-indicator" IsVisible="{Binding IsActive}"/>
								</Panel>
							</DataTemplate>

							<DataTemplate DataType="vm:DockSeparatorViewModel">
								<Border Classes="dock-separator"/>
							</DataTemplate>
						</ItemsControl.DataTemplates>
					</ItemsControl>
				</Panel>

				<ContentControl Padding="{DynamicResource Margin15}"
				                Content="{Binding NavigationStore.CurrentViewModel}"/>
			</DockPanel>

			<!-- Notifications -->
			<ItemsControl Grid.Row="1"
			              ItemsSource="{Binding Notifications.Toasts}"
			              HorizontalAlignment="Right"
			              VerticalAlignment="Bottom"
			              Width="340"
			              Margin="16"
			              ZIndex="100">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Spacing="8"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="notifVm:ToastViewModel">
						<Border Classes="toast">
							<Grid ColumnDefinitions="Auto,*,Auto">
								<materialIcons:MaterialIcon Kind="{Binding Icon}"
								                            Width="22" Height="22"
								                            VerticalAlignment="Top"
								                            Foreground="{StaticResource PrimaryAccentBrush}"/>

								<StackPanel Grid.Column="1" Margin="10,0" Spacing="2">
									<TextBlock Text="{Binding Title}"
									           FontWeight="SemiBold"
									           Foreground="{StaticResource PrimaryTextBrush}"/>
									<TextBlock Text="{Binding Message}"
									           FontSize="12"
									           TextWrapping="Wrap"
									           Foreground="#7D8DA6"/>
								</StackPanel>

								<Button Grid.Column="2"
								        Classes="window-button"
								        VerticalAlignment="Top"
								        Command="{Binding CloseCommand}">
									<materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
								</Button>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			
			<!-- Status bar -->
			<Border Grid.Row="2">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Spacing15}">

					<StackPanel Grid.Column="0"
								Orientation="Horizontal"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								Margin="{StaticResource MarginLeft15}"
								Spacing="{StaticResource Spacing5}">
						<Ellipse Width="10"
								 Height="10"
								 Fill="{Binding IsAutoWatchEnabled, Converter={StaticResource AutoWatchForegroundConverter}}"/>

						<TextBlock Text="{Binding WatchStatus}"/>
					</StackPanel>

					<TextBlock Grid.Column="1"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   Text="{Binding LogFile}" />

					<TextBlock Grid.Column="2"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   Text="{Binding LastEvent}"
							   Margin="{StaticResource MarginRight15}" />
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>
