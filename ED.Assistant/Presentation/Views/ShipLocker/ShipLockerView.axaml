<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ED.Assistant.Presentation.ViewModels.ShipLocker"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ED.Assistant.Presentation.Views.ShipLocker.ShipLockerView"
			 x:DataType="vm:ShipLockerViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">

		<ItemsControl Grid.Row="0"
					  ItemsSource="{Binding MaterialSummaries}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid Columns="4"
								 ColumnSpacing="8"
								 RowSpacing="8"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border Classes="dashboard-card">
						<StackPanel Spacing="4">
							<TextBlock Text="{Binding Title}"
									   Classes="dashboard-label"/>

							<TextBlock Text="{Binding Value}"
									   Classes="dashboard-value"/>

							<!-- e.g. "< 25%" under "Low stock" -->
							<TextBlock Text="{Binding Subtitle}"
									   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
									   Classes="dashboard-label"/>
						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Border Grid.Row="1"
				Classes="dashboard-card">
			<Grid ColumnDefinitions="*,180,160" ColumnSpacing="12">

				<TextBox PlaceholderText="Search material..."
						 Text="{Binding SearchText}"/>

				<ComboBox Grid.Column="1"
						  ItemsSource="{Binding Categories}"
						  SelectedItem="{Binding SelectedCategory}"/>

				<ComboBox Grid.Column="2"
						  ItemsSource="{Binding SortOptions}"
						  SelectedItem="{Binding SelectedSort}"/>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="2">
			<ItemsControl ItemsSource="{Binding FilteredMaterials}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel ItemWidth="260"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Classes="material-card">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

								<Grid ColumnDefinitions="*,Auto">

									<TextBlock Text="{Binding Name}"
											   Classes="dashboard-value"
											   TextTrimming="CharacterEllipsis"
											   TextWrapping="NoWrap"
											   ClipToBounds="True"/>

									<Border Grid.Column="1"
											Classes="material-category-pill">
										<TextBlock Text="{Binding Category}"/>
									</Border>
								</Grid>

								<TextBlock Grid.Row="1"
										   Text="{Binding StockText}"
										   Classes="dashboard-label"/>

								<ProgressBar Grid.Row="2"
											 Minimum="0"
											 Maximum="{Binding MaxCapacity}"
											 Value="{Binding Count}"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>
