<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ED.Assistant.Plugins</RootNamespace>
        <!-- Plugins compile against this; bump on breaking changes -->
        <Version>1.2.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Must match the host's versions exactly: these assemblies are shared with plugins -->
        <PackageReference Include="Avalonia" Version="12.1.3"/>
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.1.26425.128"/>
    </ItemGroup>
</Project>
